# ==== ARI / Asterisk ====
ARI_URL=http://127.0.0.1:8088
ARI_USER=ai_voice_app
ARI_PASS=change-me
ARI_APP=ai_voice_app
ARI_OUTBOUND_ENDPOINT_TEMPLATE=PJSIP/{number}@outbound-trunk
ARI_CALLER_ID=AI Voice <021xxxxxxx>
ARI_ORIGINATE_TIMEOUT_SEC=30

# ==== RTP bridge (audio Asterisk <-> Gemini Live) ====
RTP_LISTEN_HOST=0.0.0.0
RTP_LISTEN_PORT_START=40000
RTP_LISTEN_PORT_END=40200
# Ganti dengan IP server AI Voice ini, harus reachable dari server Asterisk
RTP_ADVERTISE_HOST=127.0.0.1
RTP_CODEC=slin16
RTP_SAMPLE_RATE_HZ=16000

# ==== Gemini Live API ====
GEMINI_API_KEY=change-me
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_LANGUAGE_CODE=id-ID
GEMINI_VOICE_NAME=Puck

# ==== 9Router (OpenAI-compatible gateway, pengganti Gemini Live) ====
# Lihat core/ninerouter_voice.py — pipeline STT -> LLM -> TTS (bukan realtime).
NINEROUTER_BASE_URL=http://studiouidesk.ddns.net:20128/v1
NINEROUTER_API_KEY=change-me
NINEROUTER_MODEL_LLM=kenari/gemini-3-8-flash
NINEROUTER_MODEL_STT=kenari/whisper-large-v3-turbo
NINEROUTER_MODEL_TTS=kenari/kokoro-tts
NINEROUTER_TTS_VOICE=af_heart
NINEROUTER_LANGUAGE=id
# Backend audio: "gemini" (jalan) atau "ninerouter" (route /audio/* masih 400)
NINEROUTER_STT_BACKEND=gemini
NINEROUTER_TTS_BACKEND=gemini
NINEROUTER_RTP_RATE=8000
NINEROUTER_VAD_THRESHOLD=500
NINEROUTER_VAD_END_SILENCE_MS=650

# ==== Gemini STT/TTS (dipakai saat NINEROUTER_*_BACKEND=gemini) ====
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# ==== Datakelola integration ====
DATAKELOLA_ENABLED=false
DATAKELOLA_BASE_URL=https://datakelola.example.com
DATAKELOLA_API_KEY=change-me

# ==== Campaign defaults ====
DEFAULT_CONCURRENT_LIMIT=5
DEFAULT_MAX_RETRY=2
CAMPAIGN_TIMEZONE=Asia/Jakarta

# ==== App ====
# Mesin suara: "gemini" (realtime) atau "ninerouter" (STT->LLM->TTS)
VOICE_ENGINE=gemini
DB_PATH=./db/ai_outbound.sqlite3
LOG_LEVEL=INFO
SCHEDULER_POLL_INTERVAL_SEC=5
